{
  "name": "easylook-api",
  "version": "1.0.0",
  "description": "EasyLook: REST API to build outfits by occasion with a visible budget and explainable Look Match recommendations.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "docs:export": "tsx scripts/export-openapi.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:integration": "jest --runInBand tests/integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mariana-Codebase/easylook.git"
  },
  "bugs": {
    "url": "https://github.com/Mariana-Codebase/easylook/issues"
  },
  "homepage": "https://github.com/Mariana-Codebase/easylook#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
