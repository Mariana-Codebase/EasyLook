NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easylook
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
CORS_ORIGIN=*
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Demo accounts created by `npm run db:seed` (development only)
SEED_ADMIN_EMAIL=admin@easylook.dev
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_EMAIL=demo@easylook.dev
SEED_DEMO_PASSWORD=Demo12345!
